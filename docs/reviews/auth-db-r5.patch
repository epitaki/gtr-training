+import { randomBytes } from 'node:crypto'
+import { mkdirSync } from 'node:fs'
+import { dirname } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+export interface LocalProfile {
+  backend: 'local'
+  id: 'system_admin'
+  display_name: string
+  role: 'admin'
+  created_at: string
+  updated_at: string
+}
+
+const SESSION_MS = 8 * 60 * 60 * 1000
+const LOGIN_NONCE_MS = 5 * 60 * 1000
+const MAX_LOGIN_NONCES = 256
+
+export class LocalAuthStore {
+  private db: DatabaseSync
+  private sessions = new Map<string, { expires: number; csrf: string }>()
+  private loginNonces = new Map<string, number>()
+
+  constructor(path: string) {
+    mkdirSync(dirname(path), { recursive: true })
+    this.db = new DatabaseSync(path)
+    this.db.exec(`CREATE TABLE IF NOT EXISTS local_profiles (
+      id TEXT PRIMARY KEY CHECK (id = 'system_admin'),
+      display_name TEXT NOT NULL CHECK (length(trim(display_name)) BETWEEN 1 AND 50),
+      role TEXT NOT NULL CHECK (role = 'admin'),
+      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+    );
+    INSERT OR IGNORE INTO local_profiles (id, display_name, role) VALUES ('system_admin', 'システム管理者', 'admin');`)
+    const columns = this.db.prepare('PRAGMA table_info(local_profiles)').all() as { name: string }[]
+    if (!columns.some(column => column.name === 'created_at')) {
+      this.db.exec('ALTER TABLE local_profiles ADD COLUMN created_at TEXT')
+      this.db.exec('UPDATE local_profiles SET created_at = updated_at WHERE created_at IS NULL')
+    }
+  }
+
+  profile(): LocalProfile {
+    const row = this.db.prepare("SELECT id, display_name, role, created_at, updated_at FROM local_profiles WHERE id = 'system_admin'").get() as { id: 'system_admin'; display_name: string; role: 'admin'; created_at: string; updated_at: string }
+    return { backend: 'local', ...row }
+  }
+
+  updateDisplayName(value: string): LocalProfile {
+    const name = value.trim()
+    if (name.length < 1 || name.length > 50) throw new Error('表示名は1〜50文字で入力してください')
+    this.db.prepare("UPDATE local_profiles SET display_name = ?, updated_at = CURRENT_TIMESTAMP WHERE id = 'system_admin'").run(name)
+    return this.profile()
+  }
+
+  login(): { id: string; csrf: string; expires: number; profile: LocalProfile } {
+    const id = randomBytes(32).toString('base64url')
+    const csrf = randomBytes(32).toString('base64url')
+    const expires = Date.now() + SESSION_MS
+    this.sessions.set(id, { expires, csrf })
+    return { id, csrf, expires, profile: this.profile() }
+  }
+
+  issueLoginNonce(): string {
+    const now = Date.now()
+    this.loginNonces.forEach((expires, token) => {
+      if (expires <= now) this.loginNonces.delete(token)
+    })
+    while (this.loginNonces.size >= MAX_LOGIN_NONCES) {
+      const oldest = this.loginNonces.keys().next().value
+      if (oldest) this.loginNonces.delete(oldest)
+    }
+    const nonce = randomBytes(32).toString('base64url')
+    this.loginNonces.set(nonce, now + LOGIN_NONCE_MS)
+    return nonce
+  }
+
+  consumeLoginNonce(nonce: string | string[] | undefined): boolean {
+    if (typeof nonce !== 'string') return false
+    const expires = this.loginNonces.get(nonce)
+    this.loginNonces.delete(nonce)
+    return !!expires && expires > Date.now()
+  }
+
+  session(id: string | undefined): { csrf: string; profile: LocalProfile } | null {
+    if (!id) return null
+    const session = this.sessions.get(id)
+    if (!session) return null
+    if (session.expires <= Date.now()) { this.sessions.delete(id); return null }
+    return { csrf: session.csrf, profile: this.profile() }
+  }
+
+  logout(id: string | undefined): void { if (id) this.sessions.delete(id) }
+  close(): void { this.sessions.clear(); this.loginNonces.clear(); this.db.close() }
+}

