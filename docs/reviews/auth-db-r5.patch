+export function selectedBackend(): SelectedBackend | null {
+  if (useFallback) return fallback
+  try {
+    const stored = sessionStorage.getItem(KEY)
+    return stored === 'cloud' || stored === 'local' ? stored : null
+  } catch { return fallback }
