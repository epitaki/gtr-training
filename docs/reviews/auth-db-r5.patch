+const MAX_BODY = 2048
+
+function json(response: ServerResponse, status: number, body: unknown, cookie?: string): void {
+  response.statusCode = status
+  response.setHeader('Content-Type', 'application/json; charset=utf-8')
+  response.setHeader('Cache-Control', 'no-store')
+  response.setHeader('X-Content-Type-Options', 'nosniff')
+  if (cookie) response.setHeader('Set-Cookie', cookie)
+  response.end(JSON.stringify(body))
+}
+
+async function readBody(request: IncomingMessage): Promise<Record<string, unknown>> {
+  let body = ''
+  for await (const chunk of request) {
+    body += chunk.toString()
+    if (body.length > MAX_BODY) throw new Error('リクエストが大きすぎます')
+  }
+  const result: unknown = JSON.parse(body)
+  if (!result || typeof result !== 'object' || Array.isArray(result)) throw new Error('不正な入力です')
+  return result as Record<string, unknown>
+}
+
+export function localAuthPlugin(): Plugin {
+  return {
+    name: 'local-auth-dev-only',
+    apply: 'serve',
+    configureServer(server) {
+      const store = new LocalAuthStore(resolve(server.config.root, '.local', 'auth.sqlite'))
+      server.httpServer?.once('close', () => store.close())
+      server.middlewares.use(async (request, response, next) => {
+        const path = request.url?.split('?')[0]
+        if (!path?.startsWith(API)) { next(); return }
+        const socketAddress = server.httpServer?.address()
+        const listen = socketAddress && typeof socketAddress !== 'string' ? socketAddress : null
+        if (!requestAllowed(request, listen)) { json(response, 403, { error: 'ローカル専用です' }); return }
+        if (path !== API && !path.startsWith(`${API}/`)) { json(response, 404, { error: '見つかりません' }); return }
+        const sessionId = cookieSession(request.headers.cookie)
+        const session = store.session(sessionId)
+        if (request.method === 'GET' && path === `${API}/session`) {
+          json(response, 200, { available: true, profile: session?.profile ?? null, csrf: session?.csrf ?? store.issueLoginNonce() })
+          return
+        }
+        if (request.method !== 'POST' || !mutationAllowed(request, request.headers.host!)) {
+          json(response, 403, { error: '許可されていません' }); return
+        }
+        try {
+          const body = await readBody(request)
+          if (path === `${API}/login`) {
+            if (Object.keys(body).length !== 0) throw new Error('不正な入力です')
+            if (!store.consumeLoginNonce(request.headers['x-gtr-csrf'])) { json(response, 403, { error: 'CSRF確認に失敗しました' }); return }
+            store.logout(sessionId)
+            const login = store.login()
+            json(response, 200, { profile: login.profile, csrf: login.csrf }, `${COOKIE}=${login.id}; HttpOnly; SameSite=Strict; Path=${API}; Max-Age=28800`)
+            return
+          }
+          if (!session) { json(response, 403, { code: 'SESSION_INVALID', error: 'セッションが無効です' }); return }
+          if (request.headers['x-gtr-csrf'] !== session.csrf) { json(response, 403, { code: 'CSRF_MISMATCH', error: 'セッション確認に失敗しました' }); return }
+          if (path === `${API}/logout`) {
+            if (Object.keys(body).length !== 0) throw new Error('不正な入力です')
+            store.logout(sessionId)
+            json(response, 200, { profile: null }, `${COOKIE}=; HttpOnly; SameSite=Strict; Path=${API}; Max-Age=0`)
+            return
+          }
+          if (path === `${API}/profile`) {
+            if (Object.keys(body).length !== 1 || typeof body.display_name !== 'string') throw new Error('不正な入力です')
+            json(response, 200, { profile: store.updateDisplayName(body.display_name) })
+            return
+          }
+          json(response, 404, { error: '見つかりません' })
+        } catch (error) {
+          json(response, 400, { error: error instanceof Error ? error.message : '不正な入力です' })
+        }
+      })
+    },
+  }
+}

