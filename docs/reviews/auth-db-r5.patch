+import { useCallback, useEffect, useRef, useState } from 'react'
+import { supabase } from '../lib/supabase'
+import { clearCloudSessionForLocal, cloudProfile, cloudUpdate, LocalAuthError, localLogin, localLogout, localSession, localUpdate, readLocalSession, retireLocalSessionForCloud, startOAuth, type AccountProfile } from './account'
+import { processOAuthCallback } from './oauthCallback'
+import { selectBackend, selectedBackend } from './backendSelection'
+
+export function useAccount() {
+  const [profile, setProfile] = useState<AccountProfile | null>(null)
+  const [availableLocal, setAvailableLocal] = useState(false)
+  const [status, setStatus] = useState<'loading' | 'guest' | 'ready' | 'error'>('loading')
+  const [error, setError] = useState<string | null>(null)
+  const generation = useRef(0)
+  const profileRef = useRef<AccountProfile | null>(null)
+  const readRevision = useRef(0)
+  const saveRevision = useRef(0)
+  const pendingSaves = useRef(0)
+  const localActive = useRef(false)
+  const localChecked = useRef(false)
+  const publishProfile = useCallback((next: AccountProfile | null) => {
+    profileRef.current = next
+    setProfile(next)
+  }, [])
+
+  useEffect(() => {
+    let active = true
+    const version = ++generation.current
+    const refresh = async () => {
+      let callbackError: string | null = null
+      try {
+        try {
+          const callbackResult = await processOAuthCallback()
+          if (callbackResult === 'success') {
+            const persisted = selectBackend('cloud')
+            try { await retireLocalSessionForCloud() }
+            catch (error) { if (!persisted) throw error }
+          }
+        }
+        catch (caught) { callbackError = caught instanceof Error ? caught.message : 'ログインを完了できませんでした' }
+        const local = await localSession()
+        localChecked.current = true
+        if (active) setAvailableLocal(!!local.available)
+        if (!active || version !== generation.current) return
+        if (callbackError) { publishProfile(null); setStatus('error'); setError(callbackError); return }
+        if (local.profile && selectedBackend() !== 'cloud') { localActive.current = true; publishProfile(local.profile); setStatus('ready'); setError(null); return }
+        if (supabase) {
+          const result = await supabase.auth.getUser()
+          if (!active || version !== generation.current) return
+          if (result.error && result.error.name !== 'AuthSessionMissingError') throw result.error
+          if (result.data.user) {
+            const cloud = await cloudProfile(result.data.user)
+            if (!active || version !== generation.current) return
+            publishProfile(cloud); setStatus('ready'); setError(callbackError); return
+          }
+        }
+        publishProfile(null); setStatus(callbackError ? 'error' : 'guest'); setError(callbackError)
+      } catch (caught) {
+        if (!active || version !== generation.current) return
+        setError(caught instanceof Error ? caught.message : 'ログインを確認できませんでした')
+        setStatus('error')
+      }
+    }
+    void refresh()
+    const subscription = supabase?.auth.onAuthStateChange((event, session) => {
+      if (event === 'INITIAL_SESSION' || !localChecked.current || localActive.current) return
+      const currentProfile = profileRef.current
+      if (session?.user && currentProfile?.backend === 'cloud' && currentProfile.id === session.user.id) {
+        const current = generation.current
+        const read = ++readRevision.current
+        const save = saveRevision.current
+        void cloudProfile(session.user).then(cloud => {
+          const existing = profileRef.current
+          if (active && current === generation.current && read === readRevision.current && save === saveRevision.current && pendingSaves.current === 0 && existing?.backend === 'cloud' && existing.id === session.user.id) {
+            // Token refresh must not replace the name being edited in the dialog.
+            publishProfile({ ...cloud, display_name: existing.display_name })
+          }
+        }).catch(() => { /* Keep the verified profile when a background refresh fails. */ })
+        return
+      }
+      const current = ++generation.current
+      ++readRevision.current
+      publishProfile(null)
+      setError(null)
+      setStatus(session?.user ? 'loading' : 'guest')
+      void (async () => {
+        if (!session?.user) {
+          if (active && current === generation.current) { publishProfile(null); setStatus('guest') }
+          return
+        }
+        try {
+          const cloud = await cloudProfile(session.user)
+          if (active && current === generation.current) { publishProfile(cloud); setStatus('ready') }
+        } catch (caught) {
+          if (active && current === generation.current) { setError(caught instanceof Error ? caught.message : 'プロフィールを読めませんでした'); setStatus('error') }
+        }
+      })()
+    }).data.subscription
+    return () => { active = false; generation.current++; subscription?.unsubscribe() }
+  }, [publishProfile])
+
+  const act = useCallback(async (operation: () => Promise<AccountProfile | null>, saving = false) => {
+    const version = ++generation.current
+    ++readRevision.current
+    if (saving) { ++saveRevision.current; ++pendingSaves.current }
+    setStatus('loading'); setError(null)
+    try {
+      const next = await operation()
+      if (version === generation.current) {
+        localActive.current = next?.backend === 'local'
+        if (next?.backend === 'local') selectBackend('local')
+        publishProfile(next); setStatus(next ? 'ready' : 'guest')
+      }
+    } catch (caught) {
+      if (version !== generation.current) return
+      if (caught instanceof LocalAuthError && (caught.code === 'SESSION_INVALID' || caught.code === 'CSRF_MISMATCH')) {
+        try {
+          const latest = await readLocalSession()
+          if (version !== generation.current) return
+          setAvailableLocal(!!latest.available)
+          localActive.current = latest.profile?.backend === 'local'
+          publishProfile(latest.profile)
+          setStatus(latest.profile ? 'ready' : 'guest')
+          setError(latest.profile ? 'セッションを更新しました。もう一度お試しください。' : 'ログイン期限が切れました。もう一度ログインしてください。')
+        } catch (recheckError) {
+          if (version !== generation.current) return
+          localActive.current = false
+          publishProfile(null)
+          setStatus('error')
+          setError(recheckError instanceof Error ? recheckError.message : 'セッションを確認できませんでした')
+        }
+        return
+      }
+      setError(caught instanceof Error ? caught.message : '処理に失敗しました')
+      setStatus(profile ? 'ready' : 'error')
+    } finally {
+      if (saving) { --pendingSaves.current; ++saveRevision.current }
+    }
+  }, [profile, publishProfile])
+
+  return {
+    profile, availableLocal, configuredCloud: !!supabase, status, error,
+    loginCloud: startOAuth,
+    loginLocal: () => act(async () => {
+      localActive.current = true
+      try { await clearCloudSessionForLocal(); return await localLogin() }
+      catch (caught) { localActive.current = false; throw caught }
+    }),
+    saveName: (name: string) => act(async () => {
+      const clean = name.trim()
+      if (clean.length < 1 || clean.length > 50) throw new Error('表示名は1〜50文字で入力してください')
+      if (!profile) throw new Error('ログインしてください')
+      if (profile.backend === 'local') return localUpdate(clean)
+      await cloudUpdate(clean, profile.id)
+      return { ...profile, display_name: clean }
+    }, true),
+    logout: () => act(async () => {
+      if (profile?.backend === 'local') { await clearCloudSessionForLocal(); await localLogout() }
+      else if (supabase) { const result = await supabase.auth.signOut(); if (result.error) throw result.error }
+      return null
+    }),
+  }
