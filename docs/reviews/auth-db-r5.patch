+import type { User } from '@supabase/supabase-js'
+import { supabase } from '../lib/supabase'
+import { preserveReplayHash } from './oauthCallback'
+
+export interface AccountProfile {
+  backend: 'cloud' | 'local'
+  id: string
+  display_name: string
+  role: 'user' | 'admin'
+  avatar_url?: string | null
+  provider?: string
+}
+
+export function providerOf(user: User): string | undefined {
+  return user.app_metadata?.provider || user.identities?.[0]?.provider
+}
+
+export async function cloudProfile(user: User): Promise<AccountProfile> {
+  if (!supabase) throw new Error('Supabaseが設定されていません')
+  const { data, error } = await supabase.from('profiles').select('id,display_name,avatar_url,role').eq('id', user.id).single()
+  if (error) throw error
+  return { backend: 'cloud', id: data.id, display_name: data.display_name, avatar_url: data.avatar_url, role: data.role, provider: providerOf(user) }
+}
+
+export async function startOAuth(provider: 'google' | 'github'): Promise<void> {
+  if (!supabase) throw new Error('Supabaseが設定されていません')
+  preserveReplayHash()
+  const redirectTo = `${location.origin}${location.pathname}?auth_callback=1`
+  const result = await supabase.auth.signInWithOAuth({ provider, options: { redirectTo } })
+  if (result.error) throw result.error
+}
+
+export async function clearCloudSessionForLocal(): Promise<void> {
+  if (!supabase) return
+  await supabase.auth.signOut({ scope: 'local' })
+  const current = await supabase.auth.getSession()
+  if (current.error || current.data.session) throw new Error('以前のクラウドログインを終了できませんでした')
+}
+
+interface LocalResponse { available?: boolean; profile: AccountProfile | null; csrf?: string | null; error?: string; code?: string }
+export class LocalAuthError extends Error {
+  constructor(message: string, readonly code?: string) { super(message); this.name = 'LocalAuthError' }
+}
+let localCsrf: string | null = null
+
+async function localRequest(path: string, body?: Record<string, unknown>): Promise<LocalResponse> {
+  const response = await fetch(`/api/local-auth/${path}`, {
+    method: body ? 'POST' : 'GET', credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json', 'X-GTR-Local-Auth': '1', ...(localCsrf ? { 'X-GTR-CSRF': localCsrf } : {}) } : {},
+    body: body ? JSON.stringify(body) : undefined, cache: 'no-store',
+  })
+  if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('ローカル管理者は利用できません')
+  const data = await response.json() as LocalResponse
+  if (!response.ok) throw new LocalAuthError(data.error || 'ローカル管理者の処理に失敗しました', data.code)
+  if (data.csrf !== undefined) localCsrf = data.csrf
+  return data
+}
+
+export async function readLocalSession(): Promise<LocalResponse> { return localRequest('session') }
+export async function localSession(): Promise<LocalResponse> {
+  try { return await readLocalSession() }
+  catch { return { available: false, profile: null } }
+}
+export async function localLogin(): Promise<AccountProfile> {
+  const bootstrap = await localSession()
+  if (bootstrap.profile) return bootstrap.profile
+  if (!bootstrap.available || !bootstrap.csrf) throw new Error('ローカル管理者は利用できません')
+  return (await localRequest('login', {})).profile!
+}
+export async function localUpdate(name: string): Promise<AccountProfile> { return (await localRequest('profile', { display_name: name })).profile! }
+export async function localLogout(): Promise<void> { await localRequest('logout', {}); localCsrf = null }
+
+export async function retireLocalSessionForCloud(): Promise<void> {
+  if (!import.meta.env.DEV) return
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const current = await readLocalSession()
+    if (!current.profile) return
+    try { await localLogout(); return }
+    catch (error) {
+      if (!(error instanceof LocalAuthError) || (error.code !== 'SESSION_INVALID' && error.code !== 'CSRF_MISMATCH')) throw error
+    }
+  }
+  throw new Error('ローカルセッションを終了できませんでした')
+}
+
+export async function cloudUpdate(name: string, id: string): Promise<void> {
+  if (!supabase) throw new Error('Supabaseが設定されていません')
+  const { error } = await supabase.from('profiles').update({ display_name: name.trim() }).eq('id', id).select('id').single()
+  if (error) throw error
+}

