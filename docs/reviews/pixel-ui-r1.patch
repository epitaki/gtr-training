+import KeyboardInstructions from './KeyboardInstructions'
+
+const subscription = vi.hoisted(() => ({ tracking: false, cleanups: [] as Array<() => void>, changed: vi.fn() }))
+// The project has no DOM test environment. Exercise the external-store subscription contract
+// explicitly while using React's real server rendering for the markup and mode-specific content.
+vi.mock('react', async importOriginal => {
+  const react = await importOriginal<typeof import('react')>()
+  return { ...react, useSyncExternalStore: (subscribe: (listener: () => void) => () => void, snapshot: () => unknown, serverSnapshot: () => unknown) => {
+    if (!subscription.tracking) return react.useSyncExternalStore(subscribe, snapshot, serverSnapshot)
+    subscription.cleanups.push(subscribe(subscription.changed))
+    return snapshot()
+  } }
+})
+
+afterEach(() => {
+  subscription.cleanups.splice(0).forEach(cleanup => cleanup())
+  subscription.tracking = false
+  subscription.changed.mockClear()
+  vi.unstubAllGlobals()
+  saveBindings(defaultBindings())
+})
+
