+import { describe, expect, it } from 'vitest'
+import { InputController } from './InputController'
+import { PRESETS, bindingConflict, defaultBindings, validateBindings } from './bindings'
+
+describe('keyboard bindings', () => {
+  it('keeps the two approved presets and rejects ambiguous or invalid saved bindings', () => {
+    expect(PRESETS.official.quickDrop).toEqual(['Space'])
+    expect(PRESETS.recommended.quickDrop).toEqual(['ArrowUp', 'Shift', 'KeyC'])
+    const bindings = defaultBindings()
+    expect(validateBindings(bindings)).toBe(true)
+    bindings.evaluate = ['KeyU']
+    expect(bindingConflict(bindings)).toContain('巻戻しと評価')
+    expect(validateBindings(bindings)).toBe(false)
+    bindings.evaluate = ['OSLeft']
+    expect(validateBindings(bindings)).toBe(false)
+  })
+
+  it('preserves short press edges, repeats movement at 150ms, and leaves single actions one shot', () => {
+    const input = new InputController(defaultBindings())
+    input.pressPhysical('KeyX')
+    input.releasePhysical('KeyX')
+    expect(input.frame(0)).toEqual(new Set(['rotateRight']))
+    expect(input.frame(1)).toEqual(new Set())
+    input.pressPhysical('ArrowLeft')
+    expect(input.frame(10)).toEqual(new Set(['left']))
+    expect(input.frame(159)).toEqual(new Set())
+    expect(input.frame(160)).toEqual(new Set(['left']))
+    input.releasePhysical('ArrowLeft')
+    expect(input.frame(310)).toEqual(new Set())
+  })
+
+  it('shares action state across synonymous keys and both physical modifiers', () => {
+    const input = new InputController(defaultBindings())
+    input.pressPhysical('ControlLeft')
+    input.pressPhysical('ControlRight')
+    expect(input.frame(0)).toEqual(new Set(['softDrop']))
+    input.releasePhysical('ControlLeft')
+    expect(input.frame(150)).toEqual(new Set(['softDrop']))
+    input.releasePhysical('ControlRight')
+    expect(input.frame(300)).toEqual(new Set())
+    expect(input.actionForCode('Numpad4')).toBe('left')
+  })
+
+  it('cancels opposing movement and rotation, including a new direction against a held one', () => {
+    const input = new InputController(defaultBindings())
+    input.pressPhysical('ArrowLeft')
+    input.pressPhysical('ArrowRight')
+    input.pressPhysical('KeyZ')
+    input.pressPhysical('KeyX')
+    expect(input.frame(0)).toEqual(new Set())
+    input.releasePhysical('ArrowRight')
+    input.releasePhysical('KeyX')
+    expect(input.frame(150)).toEqual(new Set(['left']))
+    input.pressPhysical('KeyZ')
+    expect(input.frame(151)).toEqual(new Set())
+    input.pressPhysical('KeyX')
+    expect(input.frame(152)).toEqual(new Set())
+  })
+
+  it('cancels opposite short taps even when both keys were released before the frame', () => {
+    const input = new InputController(defaultBindings())
+    for (const code of ['ArrowLeft', 'ArrowRight', 'KeyZ', 'KeyX']) {
+      input.pressPhysical(code)
+      input.releasePhysical(code)
+    }
+    expect(input.frame(0)).toEqual(new Set())
+  })
+
+  it('drops held edges on apply and waits for old sources to release', () => {
+    const input = new InputController(defaultBindings())
+    input.pressPhysical('KeyX')
+    input.setBindings(defaultBindings())
+    expect(input.frame(0)).toEqual(new Set())
+    input.pressPhysical('KeyX', true)
+    expect(input.frame(150)).toEqual(new Set())
+    input.releasePhysical('KeyX')
+    input.pressPhysical('KeyX')
+    expect(input.frame(151)).toEqual(new Set(['rotateRight']))
+    input.releaseAll()
+    input.pressPhysical('KeyX', true)
+    expect(input.frame(152)).toEqual(new Set())
+    input.releasePhysical('KeyX')
+    input.pressPhysical('KeyX')
+    expect(input.frame(153)).toEqual(new Set(['rotateRight']))
+  })
+})
diff --git "a/C:\\Users\\sunpe\\.codex\\worktrees\\9028\\gtr-training\\src\\game\\input\\InputController.ts" "b/C:\\Users\\sunpe\\.codex\\worktrees\\9028\\gtr-training\\src\\game\\input\\InputController.ts"
new file mode 100644
index 0000000..4be1f6d
--- /dev/null
+++ "b/C:\\Users\\sunpe\\.codex\\worktrees\\9028\\gtr-training\\src\\game\\input\\InputController.ts"
@@ -0,0 +1,99 @@
+import { ACTIONS, normalizedCode, type Bindings, type BoundAction, type GameAction } from './bindings'
+
+const REPEATING = new Set<GameAction>(['left', 'right', 'softDrop'])
+const INTERVAL = 150
+
+/** Input sources are kept separately so releasing one finger or modifier cannot release another. */
+export class InputController {
+  private bindings: Bindings
+  private readonly held = new Map<string, GameAction>()
+  private readonly physical = new Set<string>()
+  private readonly blocked = new Set<string>()
+  private readonly pending = new Set<GameAction>()
+  private readonly last = new Map<GameAction, number>()
+  private releaseGate = false
+
+  constructor(bindings: Bindings) { this.bindings = bindings }
+
+  setBindings(bindings: Bindings): void {
+    this.bindings = bindings
+    this.suppressUntilRelease()
+  }
+
+  actionForCode(code: string): BoundAction | undefined {
+    const normalized = normalizedCode(code)
+    return ACTIONS.find(action => this.bindings[action].includes(normalized))
+  }
+
+  pressPhysical(code: string, repeat = false): boolean {
+    const action = this.actionForCode(code)
+    if (!action) return false
+    if (this.physical.has(code)) return true
+    if (repeat || this.blocked.has(code)) return true
+    this.physical.add(code)
+    this.press(action, `key:${code}`)
+    return true
+  }
+
+  releasePhysical(code: string): void {
+    this.physical.delete(code)
+    this.blocked.delete(code)
+    this.release(`key:${code}`)
+    if (this.physical.size === 0 && this.blocked.size === 0) this.releaseGate = false
+  }
+
+  press(action: GameAction, source: string): void {
+    if (this.releaseGate || this.held.has(source)) return
+    const active = this.isHeld(action)
+    this.held.set(source, action)
+    if (!active) this.pending.add(action)
+  }
+
+  release(source: string): void { this.held.delete(source) }
+
+  releaseAll(): void {
+    this.held.clear()
+    this.physical.clear()
+    this.blocked.clear()
+    this.pending.clear()
+    this.last.clear()
+    this.releaseGate = false
+  }
+
+  suppressUntilRelease(): void {
+    for (const code of this.physical) this.blocked.add(code)
+    this.held.clear()
+    this.pending.clear()
+    this.last.clear()
+    this.releaseGate = this.blocked.size > 0
+  }
+
+  isHeld(action: GameAction): boolean { return [...this.held.values()].includes(action) }
+  isGated(): boolean { return this.releaseGate }
+
+  /** Consume one frame; an edge survives keyup before the next update. */
+  frame(time: number): Set<GameAction> {
+    if (this.releaseGate) return new Set()
+    const result = new Set(this.pending)
+    this.pending.clear()
+    for (const action of REPEATING) {
+      if (!this.isHeld(action)) { this.last.delete(action); continue }
+      const previous = this.last.get(action)
+      if (result.has(action)) this.last.set(action, time)
+      else if (previous === undefined || time - previous >= INTERVAL) {
+        result.add(action)
+        this.last.set(action, time)
+      }
+    }
+    if ((result.has('left') && result.has('right')) ||
+        (result.has('left') && this.isHeld('right')) ||
+        (result.has('right') && this.isHeld('left'))) {
+      result.delete('left'); result.delete('right')
+    }
+    if ((result.has('rotateLeft') && result.has('rotateRight')) ||
+        (this.isHeld('rotateLeft') && this.isHeld('rotateRight'))) {
+      result.delete('rotateLeft'); result.delete('rotateRight')
+    }
+    return result
+  }
+}
