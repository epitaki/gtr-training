-  const texts = new Map<string, { on: ReturnType<typeof vi.fn>; setText: ReturnType<typeof vi.fn> }>()
-  const graphic = () => {
-    const item = {
-      setDepth: vi.fn(), setOrigin: vi.fn(), setAlpha: vi.fn(), setText: vi.fn(), setInteractive: vi.fn(),
-      on: vi.fn(), add: vi.fn(), destroy: vi.fn(),
