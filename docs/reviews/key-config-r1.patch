+import { useEffect, useState } from 'react'
+import {
+  ACTIONS, ACTION_LABELS, ALLOWED_CODES, BASIC_ACTIONS, PRESETS,
+  bindingConflict, defaultBindings, displayCode, normalizedCode, type Bindings, type BoundAction,
+} from '../../game/input/bindings'
+import { getBindings, getSettingsNotice, saveBindings } from '../../game/input/settings'
+
+interface Props { onClose: () => void }
+
+export default function KeySettings({ onClose }: Props) {
+  const [draft, setDraft] = useState<Bindings>(() => structuredClone(getBindings()))
+  const [capture, setCapture] = useState<BoundAction | null>(null)
+  const [message, setMessage] = useState(getSettingsNotice() ?? '')
+  const conflict = bindingConflict(draft)
+
+  useEffect(() => {
+    if (!capture) return
+    const handle = (event: KeyboardEvent) => {
+      event.preventDefault()
+      event.stopPropagation()
+      if (event.isComposing || event.keyCode === 229 || event.repeat) return
+      const code = normalizedCode(event.code)
+      if (!ALLOWED_CODES.has(code)) { setMessage(`${event.code}は割り当てできません`); return }
+      setDraft(old => ({ ...old, [capture]: old[capture].includes(code) ? old[capture] : [...old[capture], code] }))
+      setCapture(null)
+      setMessage('')
+    }
+    window.addEventListener('keydown', handle, true)
+    return () => window.removeEventListener('keydown', handle, true)
+  }, [capture])
+
+  const preset = (name: keyof typeof PRESETS) => {
+    setDraft(old => {
+      const next = structuredClone(old)
+      for (const action of BASIC_ACTIONS) next[action] = [...PRESETS[name][action]]
+      return next
+    })
+    setMessage('基本7操作を切り替えました。固有操作は保持します。')
+  }
+  const save = () => {
+    if (conflict) { setMessage(conflict); return }
+    try {
+      if (saveBindings(draft)) onClose()
+      else setMessage(getSettingsNotice() ?? '今回のみ適用しました。保存できませんでした。')
+    }
+    catch (error) { setMessage(error instanceof Error ? error.message : '設定を適用できませんでした') }
+  }
+
+  return <div role="dialog" aria-modal="true" aria-label="キー設定"
+    className="fixed inset-0 z-50 overflow-auto bg-black/80 p-4 text-white">
+    <div className="mx-auto max-w-2xl rounded-2xl border border-violet-300/30 bg-[#221b39] p-5">
+      <h2 className="mb-3 text-xl font-bold">キー設定</h2>
+      <p className="mb-4 text-sm text-white/70">ゲーム画面を選ぶとキーボード操作に戻ります。Ctrl・Shiftは左右共通、NumキーはNumLockに関係なく同じ操作です。</p>
+      <div className="mb-4 flex flex-wrap gap-2">
+        <button type="button" onClick={() => preset('official')} className="rounded bg-violet-600 px-3 py-2">オフィシャル</button>
+        <button type="button" onClick={() => preset('recommended')} className="rounded bg-violet-600 px-3 py-2">おすすめ</button>
+        <button type="button" onClick={() => { setDraft(defaultBindings()); setMessage('すべておすすめ初期値に戻しました。') }} className="rounded bg-slate-600 px-3 py-2">すべて初期化</button>
+      </div>
+      <div className="grid gap-2">
+        {ACTIONS.map(action => <div key={action} className="flex flex-wrap items-center gap-2 rounded bg-white/5 p-2">
+          <span className="w-32 font-bold">{ACTION_LABELS[action]}</span>
+          {draft[action].map(code => <button key={code} type="button" aria-label={`${ACTION_LABELS[action]}から${displayCode(code)}を削除`}
+            onClick={() => setDraft(old => ({ ...old, [action]: old[action].filter(item => item !== code) }))}
+            className="rounded border border-white/30 px-2 py-1 text-sm">{displayCode(code)} ×</button>)}
+          <button type="button" onClick={() => { setCapture(action); setMessage('キーを押してください。取消は下のボタンです。') }}
+            className="rounded border border-violet-300 px-2 py-1 text-sm">追加</button>
+        </div>)}
+      </div>
+      {capture && <button type="button" onClick={() => setCapture(null)} className="mt-3 rounded bg-amber-700 px-3 py-2">キー取得を取消</button>}
+      {(conflict || message) && <p role="status" className="mt-3 text-amber-200">{conflict ?? message}</p>}
+      <div className="mt-5 flex gap-3">
+        <button type="button" disabled={Boolean(conflict) || Boolean(capture)} onClick={save} className="rounded bg-emerald-700 px-5 py-2 disabled:opacity-40">保存</button>
+        <button type="button" onClick={onClose} className="rounded bg-slate-600 px-5 py-2">取消</button>
+      </div>
+    </div>
+  </div>
+}
